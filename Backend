def get_all_feedback():
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute('''
        SELECT feedback_id, user_id, post_id, contact, message, created_at
        FROM FEEDBACK
        ORDER BY created_at DESC
    ''')
    data = cursor.fetchall()
