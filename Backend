    total = len(records)
    fake = 0
    real = 0

    for row in records:
        prediction = str(row[2]).strip().lower() if row[2] is not None else ""

        if prediction == "fake":
            fake += 1
        elif prediction == "real":
            real += 1

    fake_rate = round((fake / total) * 100, 1) if total > 0 else 0.0
    feedback_count = get_feedback_count()

    return {
        "total": total,
        "fake_count": fake,
        "real_count": real,
        "fake_rate": fake_rate,
        "feedback_count": feedback_count
    }


