      "source": [
        "# Installing the required libraries\n",
        "!pip install -q imbalanced-learn scikit-learn matplotlib seaborn\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import scipy.sparse as sp\n",
        "import time\n",
        "import joblib\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "from sklearn.model_selection import train_test_split, cross_val_score, StratifiedKFold\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.svm import LinearSVC\n",
        "from sklearn.calibration import CalibratedClassifierCV\n",
        "from sklearn.metrics import (\n",
        "    classification_report, confusion_matrix,\n",
        "    accuracy_score, precision_score, recall_score,\n",
        "    f1_score, roc_auc_score\n",
        ")\n",
        "from imblearn.over_sampling import SMOTE\n",
        "from imblearn.pipeline import Pipeline as ImbPipeline\n",
        "\n",
        "\n",
        "from google.colab import files\n",
        "import os\n",
        "\n",
        "print(\"Upload the required files\")\n",
        "uploaded = files.upload()\n",
        "\n",
        "for filename in uploaded.keys():\n",
        "    print(f\" ✓ {filename} ({len(uploaded[filename]) / 1024:.1f} KB)\")\n",
        "\n",
        "\n",
        "X_train = sp.load_npz('X_train_ready.npz')\n",
        "y_train = pd.read_csv('y_train_ready.csv')['fraudulent'].values\n",
        "\n",
        "print(\"\\nData loaded successfully!\")\n",
        "print(f\"\\n  Total ads:        {X_train.shape[0]:,}\")\n",
        "print(f\"  Features:         {X_train.shape[1]:,}\")\n",
        "print(f\"  Real ads (0):     {(y_train == 0).sum():,}\")\n",
        "print(f\"  Fake ads (1):     {(y_train == 1).sum():,}\")\n",
        "print(f\"  % Fake:           {(y_train == 1).sum() / len(y_train) * 100:.2f}%\")\n",
        "\n",
        "# Data split 80/20\n",
        "X_train_split, X_test_split, y_train_split, y_test_split = train_test_split(\n",
        "    X_train, y_train,\n",
        "    test_size=0.2,\n",
        "    random_state=42,\n",
        "    stratify=y_train\n",
        ")\n",
        "\n",
        "print(\"\\n Data split successfully\")\n",
        "print(f\"\\n Training: {X_train_split.shape[0]:,} | Real: {(y_train_split==0).sum():,} | Fake: {(y_train_split==1).sum():,}\")\n",
        "print(f\" Testing:  {X_test_split.shape[0]:,} | Real: {(y_test_split==0).sum():,}  | Fake: {(y_test_split==1).sum():,}\")\n",
        "\n",
        "\n",
        "print(\"Defining models with Pipeline (SMOTE inside each fold)\")\n",
        "\n",
        "models = {\n",
        "    'Logistic Regression': ImbPipeline([\n",
        "        ('smote', SMOTE(random_state=42, k_neighbors=5)),\n",
        "        ('model', LogisticRegression(\n",
        "            max_iter=1000,\n",
        "            random_state=42,\n",
        "            solver='liblinear',\n",
        "            C=1.0,\n",
        "            class_weight='balanced'\n",
        "        ))\n",
        "    ]),\n",
        "\n",
        "    'Random Forest': ImbPipeline([\n",
        "        ('smote', SMOTE(random_state=42, k_neighbors=5)),\n",
        "        ('model', RandomForestClassifier(\n",
        "            n_estimators=100,\n",
        "            max_depth=20,\n",
        "            min_samples_split=10,\n",
        "            min_samples_leaf=4,\n",
        "            random_state=42,\n",
        "            n_jobs=-1,\n",
        "            class_weight='balanced'\n",
        "        ))\n",
        "    ]),\n",
        "\n",
        "    'Support Vector Machine (SVM)': ImbPipeline([\n",
        "        ('smote', SMOTE(random_state=42, k_neighbors=5)),\n",
        "        ('model', CalibratedClassifierCV(\n",
        "            LinearSVC(\n",
        "                C=1.0,\n",
        "                random_state=42,\n",
        "                class_weight='balanced'\n",
        "            ),\n",
        "            cv=3\n",
        "        ))\n",
        "    ])\n",
        "}\n",
        "\n",
        "print(\"\\nModels ready:\")\n",
        "for i, name in enumerate(models.keys(), 1):\n",
        "    print(f\"  {i}. {name}\")\n",
        "\n",
        "\n",
        "#training the models\n",
        "\n",
        "print(\"Starting training for all three models\")\n",
        "\n",
        "results = []\n",
        "\n",
        "for name, pipeline in models.items():\n",
        "    print(f\"Model: {name}\")\n",
        "\n",
        "    # Step 1: Training\n",
        "    start_time = time.time()\n",
        "\n",
        "\n",
        "\n",
        "    pipeline.fit(X_train_split, y_train_split)\n",
        "    training_time = time.time() - start_time\n",
        "    print(f\"  Completed in {training_time:.1f} seconds\")\n",
        "\n",
        "    # Step 2: Prediction\n",
        "\n",
        "    y_pred = pipeline.predict(X_test_split)\n",
        "\n",
        "    if hasattr(pipeline, 'predict_proba'):\n",
        "        y_pred_proba = pipeline.predict_proba(X_test_split)[:, 1]\n",
        "    else:\n",
        "        y_pred_proba = None\n",
        "\n",
        "    accuracy  = accuracy_score(y_test_split, y_pred)\n",
        "    precision = precision_score(y_test_split, y_pred, zero_division=0)\n",
        "    recall = recall_score(y_test_split, y_pred, zero_division=0)\n",
        "    f1 = f1_score(y_test_split, y_pred, zero_division=0)\n",
        "\n",
        "\n",
        "    auc = roc_auc_score(y_test_split, y_pred_proba) if y_pred_proba is not None else 0\n",
        "\n",
        "    # Step 3: Cross-Validation\n",
        "\n",
        "\n",
        "     #spilt the data into 5 parts\n",
        "\n",
        "\n",
        "    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
        "\n",
        "\n",
        "    cv_scores = cross_val_score(\n",
        "        pipeline,\n",
        "        X_train_split,\n",
        "        y_train_split,\n",
        "        cv=cv,\n",
        "        scoring='f1',\n",
        "        n_jobs=-1 #This is only to improve speed, and has nothing to do with the actual result.\n",
        "    )\n",
        "    print(f\"  CV F1: {cv_scores.mean():.4f} ± {cv_scores.std():.4f}\")  #نرجع له\n",
        "\n",
        "    results.append({\n",
        "        'Model': name,\n",
        "        'Training Time (s)': training_time,\n",
        "        'Accuracy': accuracy,\n",
        "        'Precision': precision,\n",
        "        'Recall': recall,\n",
        "        'F1-Score': f1,\n",
        "        'AUC': auc,\n",
        "        'CV F1 Mean': cv_scores.mean(),\n",
        "        'CV F1 Std': cv_scores.std()\n",
        "    })\n",
        "\n",
        "    print(f\"\\n  Accuracy:  {accuracy:.4f}\")\n",
        "    print(f\"  Precision: {precision:.4f}\")\n",
        "    print(f\"  Recall:    {recall:.4f}\")\n",
        "    print(f\"  F1-Score:  {f1:.4f}\")\n",
        "    if auc > 0:\n",
        "        print(f\"  AUC:       {auc:.4f}\")\n",
        "\n",
        "\n",
        "# Comparing models and choosing the best\n",
        "results_df = pd.DataFrame(results).sort_values('F1-Score', ascending=False)\n",
        "\n",
        "print(\"\\nFinal Model Comparison:\")\n",
        "print(results_df[['Model','Accuracy','Precision','Recall','F1-Score','AUC','CV F1 Mean']].to_string(index=False))\n",
        "\n",
        "best_model_name = results_df.iloc[0]['Model']\n",
        "best_f1         = results_df.iloc[0]['F1-Score']\n",
        "best_pipeline   = models[best_model_name]\n",
        "\n",
        "print(f\"\\n Best Model: {best_model_name}\")\n",
        "print(f\" F1-Score:   {best_f1:.4f}\")\n",
        "\n",
        "# Detailed explanation of the best model\n",
        "y_pred_best = best_pipeline.predict(X_test_split)\n",
        "print(\"\\nClassification Report:\")\n",
        "print(classification_report(y_test_split, y_pred_best,\n",
        "      target_names=['Real (0)', 'Fake (1)'], digits=4))\n",
        "\n",
        "cm = confusion_matrix(y_test_split, y_pred_best)\n",
        "tn, fp, fn, tp = cm.ravel()\n",
        "print(f\"  True Negatives  (TN): {tn:,}  - Predicted Real, was Real\")\n",
        "print(f\"  False Positives (FP): {fp:,}   - Predicted Fake, was Real\")\n",
        "print(f\"  False Negatives (FN): {fn:,}   - Predicted Real, was Fake\")\n",
        "print(f\"  True Positives  (TP): {tp:,}  - Predicted Fake, was Fake\")\n",
        "\n",
        "# Plotting the results\n",
        "fig = plt.figure(figsize=(16, 9))\n",
        "gs  = fig.add_gridspec(2, 3, hspace=0.35, wspace=0.35)\n",
        "\n",
        "colors_f1  = ['gold' if n == best_model_name else 'skyblue'    for n in results_df['Model']]\n",
        "colors_acc = ['gold' if n == best_model_name else 'lightgreen' for n in results_df['Model']]\n",
        "colors_auc = ['gold' if n == best_model_name else 'mediumpurple' for n in results_df['Model']]\n",
        "\n",
        "ax1 = fig.add_subplot(gs[0, 0])\n",
        "bars = ax1.barh(results_df['Model'], results_df['F1-Score'], color=colors_f1, edgecolor='black')\n",
        "ax1.set_xlabel('F1-Score'); ax1.set_title('F1-Score Comparison', fontweight='bold'); ax1.set_xlim([0,1])\n",
        "for b in bars: ax1.text(b.get_width()+.01, b.get_y()+b.get_height()/2, f'{b.get_width():.3f}', va='center', fontsize=9)\n",
        "\n",
        "ax2 = fig.add_subplot(gs[0, 1])\n",
        "bars = ax2.barh(results_df['Model'], results_df['Accuracy'], color=colors_acc, edgecolor='black')\n",
        "ax2.set_xlabel('Accuracy'); ax2.set_title('Accuracy Comparison', fontweight='bold'); ax2.set_xlim([0,1])\n",
        "for b in bars: ax2.text(b.get_width()+.01, b.get_y()+b.get_height()/2, f'{b.get_width():.3f}', va='center', fontsize=9)\n",
        "\n",
        "ax3 = fig.add_subplot(gs[0, 2])\n",
        "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=ax3,\n",
        "            xticklabels=['Real','Fake'], yticklabels=['Real','Fake'])\n",
        "ax3.set_title(f'Confusion Matrix\\n{best_model_name}', fontweight='bold')\n",
        "ax3.set_ylabel('True Label'); ax3.set_xlabel('Predicted Label')\n",
        "\n",
        "ax4 = fig.add_subplot(gs[1, 0])\n",
        "x = np.arange(len(results_df)); w = 0.35\n",
        "ax4.barh(x-w/2, results_df['Precision'], w, label='Precision', color='coral',     edgecolor='black')\n",
        "ax4.barh(x+w/2, results_df['Recall'],    w, label='Recall',    color='lightblue', edgecolor='black')\n",
        "ax4.set_yticks(x); ax4.set_yticklabels(results_df['Model'])\n",
        "ax4.set_xlabel('Score'); ax4.set_title('Precision vs Recall', fontweight='bold')\n",
        "ax4.legend(); ax4.set_xlim([0,1])\n",
        "\n",
        "ax5 = fig.add_subplot(gs[1, 1])\n",
        "bars = ax5.barh(results_df['Model'], results_df['AUC'], color=colors_auc, edgecolor='black')\n",
        "ax5.set_xlabel('AUC Score'); ax5.set_title('AUC Comparison', fontweight='bold'); ax5.set_xlim([0,1])\n",
        "for b in bars:\n",
        "    if b.get_width() > 0:\n",
        "        ax5.text(b.get_width()+.01, b.get_y()+b.get_height()/2, f'{b.get_width():.3f}', va='center', fontsize=9)\n",
        "\n",
        "ax6 = fig.add_subplot(gs[1, 2])\n",
        "hm = results_df[['Accuracy','Precision','Recall','F1-Score','AUC']].T\n",
        "sns.heatmap(hm, annot=True, fmt='.3f', cmap='YlGnBu', ax=ax6,\n",
        "            xticklabels=[m.replace(' ','\\n') for m in results_df['Model']])\n",
        "ax6.set_title('All Metrics Heatmap', fontweight='bold')\n",
        "\n",
        "plt.suptitle('Model Evaluation Results (Fixed Pipeline + class_weight)', fontsize=15, fontweight='bold')\n",
        "plt.show()\n",
        "\n",
        "\n",
        "'''1- Build a suitable name for the model\n",
        "\n",
        "  2- Save the entire pipeline\n",
        "\n",
        "  3- Save the results + load them from Colab'''\n",
        "\n",
        "model_filename = f'best_model_{best_model_name.replace(\" \",\"_\").replace(\"(\",\"\").replace(\")\",\"\").lower()}.pkl'\n",
        "\n",
        "joblib.dump(best_pipeline, model_filename)\n",
        "results_df.to_csv('model_comparison_results.csv', index=False)\n",
        "\n",
        "print(f\"\\nSaved: {model_filename}\")\n",
        "print(f\"Saved: model_comparison_results.csv\")\n",
        "from google.colab import files\n",
        "files.download(model_filename)\n",
        "files.download('model_comparison_results.csv')\n",
        "print(\"\\nAll files downloaded successfully!\")\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "# Quick test on examples\n",
        "print(\"Quick Test on Sample Ads\")\n",
        "\n",
        "vectorizer = joblib.load('tfidf_vectorizer.pkl')\n",
        "\n",
        "examples = [\n",
        "    {\n",
        "        'text': \"earn $5000 weekly no experience required work from home contact via telegram immediately\",\n",
        "        'features': [1, 0, 0, 0],\n",
        "        'description': 'Suspicious Ad (should be Fake)'\n",
        "    },\n",
        "    {\n",
        "        'text': \"google hiring experienced software developer competitive benefits apply now\",\n",
        "        'features': [0, 1, 1, 0],\n",
        "        'description': 'Likely Real Ad'\n",
        "    }\n",
        "]\n",
        "\n",
        "for i, ex in enumerate(examples, 1):\n",
        "    text_tfidf = vectorizer.transform([ex['text']])\n",
        "    binary     = sp.csr_matrix([ex['features']])\n",
        "    X_new      = sp.hstack([text_tfidf, binary], format='csr')\n",
        "\n",
        "    prediction = best_pipeline.predict(X_new)[0]\n",
        "    label      = 'Fake' if prediction == 1 else 'Real'\n",
        "\n",
        "    print(f\"\\nExample {i}: {ex['description']}\")\n",
        "    print(f\"  Prediction: {label}\")\n",
        "\n",
        "    if hasattr(best_pipeline, 'predict_proba'):\n",
        "        proba = best_pipeline.predict_proba(X_new)[0]\n",
        "        print(f\"  Real: {proba[0]:.1%} | Fake: {proba[1]:.1%}\")\n",
        "\n",
        "print(f\"DONE | Best Model: {best_model_name} | F1: {best_f1:.4f}\")\n"
